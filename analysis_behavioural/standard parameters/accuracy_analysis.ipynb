    }
   },
   "cell_type": "code",
   "source": [
    "# Multiply some variables by 100 to show percentage correct etc\n",
    "combined_results_dataframe['objectively_correct_boolean'] = combined_results_dataframe['objectively_correct_boolean'] * 100\n",
    "mapping = {'approach': 1, 'avoid': 0}\n",
    "combined_results_dataframe['response_boolean'] = combined_results_dataframe['response'].map(mapping)\n",
    "combined_results_dataframe['response_boolean'] = combined_results_dataframe['response_boolean'].astype('Int64')\n",
    "\n",
    "combined_results_dataframe_shortened = combined_results_dataframe[combined_results_dataframe['trials_since_reversal_combined_learning']<=10]"
   ],
