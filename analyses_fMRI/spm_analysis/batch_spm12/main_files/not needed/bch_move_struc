function [cfg] = bch_move_func(cfg)

%--------------------------------------------------------------------------
% BCH_move_func moves all the functional images to their corresponding
% directories (all files in work directory will be deleted).
%
% Created by Inge Volman for SPM8 ME wrapper, April 2011
%--------------------------------------------------------------------------

orig_dir = fullfile(cfg.dir.func,cfg.sess,cfg.dir.preproc.work);

realign_dir     = fullfile(cfg.dir.func,cfg.sess,cfg.dir.preproc.realign);      % directory for realigned & slicetimed images          
coreg_dir       = fullfile(cfg.dir.func,cfg.sess,cfg.dir.preproc.coreg);      % directory for coregistered images          
norm_dir        = fullfile(cfg.dir.func,cfg.sess,cfg.dir.preproc.norm);      % directory for normalized images          
smooth_dir      = fullfile(cfg.dir.func,cfg.sess,cfg.dir.preproc.smooth);     % directory for smoothed images          
info_dir        = fullfile(cfg.dir.func,cfg.sess,cfg.dir.info);
mean_dir        = fullfile(info_dir,cfg.dir.mean);

if ~exist(realign_dir,'dir');   mkdir(realign_dir); end
if ~exist(coreg_dir,'dir');     mkdir(coreg_dir);   end
if ~exist(norm_dir,'dir');      mkdir(norm_dir);    end
if ~exist(smooth_dir,'dir');    mkdir(smooth_dir);  end
if ~exist(info_dir,'dir');      mkdir(info_dir);    end
if strcmp(cfg.sess, 'sess_affect')
    if ~exist(mean_dir,'dir');      mkdir(mean_dir);    end
end

if ~isempty(strfind(cfg.prefix.img,'nii'))
    
    mean = dir(fullfile(orig_dir,[cfg.prefix.mean,'*.nii']));
    wmean = dir(fullfile(orig_dir,[cfg.prefix.wmean,'*.nii']));
        
    if strmatch(exist(fullfile(orig_dir,mean.name)),2); movefile(fullfile(orig_dir,mean.name),mean_dir); end
    if strmatch(exist(fullfile(orig_dir,wmean.name)),2); movefile(fullfile(orig_dir,wmean.name),mean_dir); end
    
    img_prefix = ['^',cfg.prefix.smooth,cfg.prefix.img];
    run = cfg_getfile('ExtFPList',orig_dir,img_prefix);
    if ~isempty(run); movefile(fullfile(orig_dir,[cfg.prefix.smooth,'*.nii']),smooth_dir); end
 
    img_prefix = ['^',cfg.prefix.norm,cfg.prefix.img];
    run = cfg_getfile('ExtFPList',orig_dir,img_prefix);
    if ~isempty(run); movefile(fullfile(orig_dir,[cfg.prefix.norm,'*.nii']),norm_dir); end
  
    img_prefix = ['^',cfg.prefix.coreg,cfg.prefix.img];
    run = cfg_getfile('ExtFPList',orig_dir,img_prefix);
    if ~isempty(run); movefile(fullfile(orig_dir,[cfg.prefix.coreg,'*.nii']),coreg_dir); end
  
    img_prefix = ['^',cfg.prefix.realign,cfg.prefix.img];
    run = cfg_getfile('ExtFPList',orig_dir,img_prefix);
    if ~isempty(run); movefile(fullfile(orig_dir,[cfg.prefix.realign,'*.nii']),realign_dir); end
     
end

