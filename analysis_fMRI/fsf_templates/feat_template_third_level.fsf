# FEAT version number
set fmri(version) 6.00

# Are we in MELODIC?
set fmri(inmelodic) 0

# Analysis level
set fmri(level) 2

# Which stages to run
set fmri(analysis) 2

# Use relative filenames
set fmri(relative_yn) 0

# Balloon help
set fmri(help_yn) 1

# Run Featwatcher
set fmri(featwatcher_yn) 1

# Cleanup first-level standard-space images
set fmri(sscleanup_yn) 0

# Output directory (rewritten by the bash script)
set fmri(outputdir) ""

# TR(s)
set fmri(tr) 3

# Total volumes (= number of subjects at this level)
set fmri(npts) __NSUBJECTS__

# Delete volumes
set fmri(ndelete) 0

# Perfusion tag/control order
set fmri(tagfirst) 1

# Number of first-level analyses (= number of subjects)
set fmri(multiple) __NSUBJECTS__

# Higher-level input type: 1 = lower-level FEAT directories
set fmri(inputtype) 1

# Carry out pre-stats processing?
set fmri(filtering_yn) 0

set fmri(brain_thresh) 10
set fmri(critical_z) 5.3
set fmri(noise) 0.66
set fmri(noisear) 0.34

# Motion correction (none at higher level)
set fmri(mc) 0
set fmri(sh_yn) 0
set fmri(regunwarp_yn) 0
set fmri(gdc) ""
set fmri(dwell) 0.0
set fmri(te) 0.0
set fmri(signallossthresh) 10
set fmri(unwarp_dir) y-

set fmri(st) 0
set fmri(st_file) ""
set fmri(bet_yn) 0
set fmri(smooth) 0
set fmri(norm_yn) 0
set fmri(perfsub_yn) 0
set fmri(temphp_yn) 0
set fmri(templp_yn) 0
set fmri(melodic_yn) 0

set fmri(stats_yn) 1
set fmri(prewhiten_yn) 1

set fmri(motionevs) 0
set fmri(motionevsbeta) ""
set fmri(scriptevsbeta) ""

# Robust outlier detection in FLAME
set fmri(robust_yn) 1

# Higher-level modelling: 2 = FLAME 1
set fmri(mixed_yn) 2

set fmri(randomisePermutations) 5000

# Number of EVs at group level
set fmri(evs_orig) 1
set fmri(evs_real) 1
set fmri(evs_vox) 0

# Number of contrasts
set fmri(ncon_orig) 1
set fmri(ncon_real) 1

set fmri(nftests_orig) 0
set fmri(nftests_real) 0

set fmri(constcol) 0

# Carry out post-stats steps?
set fmri(poststats_yn) 0

set fmri(threshmask) ""

# Cluster-thresholding at Z > 3.1, p < 0.05
set fmri(thresh) 3
set fmri(prob_thresh) 0.05
set fmri(z_thresh) 2.3

set fmri(zdisplay) 0
set fmri(zmin) 2
set fmri(zmax) 8
set fmri(rendertype) 1
set fmri(bgimage) 1
set fmri(tsplot_yn) 0

set fmri(reginitial_highres_yn) 0
set fmri(reginitial_highres_search) 90
set fmri(reginitial_highres_dof) 3
set fmri(reghighres_yn) 0
set fmri(reghighres_search) 90
set fmri(reghighres_dof) BBR
set fmri(regstandard_yn) 0
set fmri(alternateReference_yn) 0
set fmri(regstandard) "/opt/fsl/6.0.6/data/standard/MNI152_T1_2mm_brain"
set fmri(regstandard_search) 90
set fmri(regstandard_dof) 12
set fmri(regstandard_nonlinear_yn) 0
set fmri(regstandard_nonlinear_warpres) 10

set fmri(paradigm_hp) 100

# Number of 2nd-level copes feeding in:
# 1 = session_mean, 2 = session_2>3, 3 = session_2>4, 4 = session_3>4
set fmri(ncopeinputs) 4

# Only take session_mean forward to the group level
set fmri(copeinput.1) 1
set fmri(copeinput.2) 1
set fmri(copeinput.3) 1
set fmri(copeinput.4) 1

# ---- Per-subject feat_files() lines (injected by bash script) ----
__FEAT_FILES_BLOCK__

set fmri(confoundevs) 0

# Group-level EV 1: the group mean
set fmri(evtitle1) "group_mean"
set fmri(shape1) 2
set fmri(convolve1) 0
set fmri(convolve_phase1) 0
set fmri(tempfilt_yn1) 0
set fmri(deriv_yn1) 0
set fmri(custom1) "dummy"
set fmri(ortho1.0) 0
set fmri(ortho1.1) 0

# ---- Per-subject EV values (evgN.1 = 1) ----
__EVG_BLOCK__

# ---- Per-subject group membership (groupmem.N = 1) ----
__GROUPMEM_BLOCK__

# Contrast & F-tests mode
set fmri(con_mode_old) real
set fmri(con_mode) real

# Group-mean contrast
set fmri(conpic_real.1) 1
set fmri(conname_real.1) "group_mean"
set fmri(con_real1.1) 1

set fmri(conmask_zerothresh_yn) 0
set fmri(conmask1_1) 0

##########################################################
# Options that don't appear in the GUI

set fmri(alternative_mask) ""
set fmri(init_initial_highres) ""
set fmri(init_highres) ""
set fmri(init_standard) ""
set fmri(overwrite_yn) 0